{
  "name": "prism-workbench",
  "version": "1.1.12",
  "private": true,
  "description": "Zero-Emoji Deep Reading, Cognitive Deconstruction & Repository Interview Defense Workbench",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "node scripts/prepare-electron-standalone.mjs",
    "desktop:preview": "npm run build && npm run desktop:prepare && electron .",
    "desktop:pack": "npm run build && npm run desktop:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "desktop:build": "npm run build && npm run desktop:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "desktop:build:mac-x64": "npm run build && npm run desktop:prepare && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --x64",
    "desktop:build:win": "npm run build && npm run desktop:prepare && electron-builder --win nsis --x64 --publish never && electron-builder --win nsis --arm64 --publish never"
  },
  "build": {
    "appId": "com.purrparse.desktop",
    "productName": "PurrParse",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/build"
    },
    "publish": null,
    "npmRebuild": false,
    "afterPack": "electron/after-pack.cjs",
    "files": [
      "electron/**/*",
      "package.json",
      "!electron/build/**",
      "!electron/after-pack.cjs",
      "!node_modules/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/build/icon.icns",
      "identity": null,
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "PurrParse",
      "icon": "electron/build/icon.icns"
    },
    "win": {
      "icon": "electron/build/icon.png",
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.1.15",
    "@ai-sdk/google": "^1.1.18",
    "@ai-sdk/openai": "^1.2.1",
    "@dagrejs/dagre": "^1.1.4",
    "ai": "^4.1.54",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "katex": "^0.16.11",
    "lucide-react": "^1.74.0",
    "motion": "^14.14.0",
    "next": "^15.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-use-measure": "^2.1.7",
    "shiki": "^1.29.2",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^0.12.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/react": "^16.2.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.2.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
